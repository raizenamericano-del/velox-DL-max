# ==========================================================================
# VELOX — environment
# Copy to .env for local dev. On Railway: Project → Variables.
# Everything here is OPTIONAL — the defaults work out of the box.
# ==========================================================================

# ── Server ────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
NODE_ENV=production
APP_NAME=VELOX
APP_TAGLINE=Satu link. Semua platform.
# Behind Railway's proxy this must stay true so rate limiting sees real IPs
TRUST_PROXY=true

# ── Engine ────────────────────────────────────────────────────────────────
# Explicit path to the binary. Empty = auto-detect (env → PATH → python module
# → ./vendor/yt-dlp standalone).
YT_DLP_PATH=
# Download the standalone binary if nothing is found (buildpack deploys)
YTDLP_AUTO_INSTALL=true
# Re-download the vendored binary when it gets older than YTDLP_UPDATE_HOURS.
# This is how the app self-heals after a platform changes its page structure.
YTDLP_AUTO_UPDATE=true
YTDLP_UPDATE_HOURS=12
# Path to ffmpeg. Empty = look for `ffmpeg` on PATH.
FFMPEG_PATH=
# Netscape cookies.txt for Instagram / age-gated / members-only content.
# Export from your browser with an extension like "Get cookies.txt LOCALLY".
YTDLP_COOKIES=

# ── Behaviour ─────────────────────────────────────────────────────────────
CACHE_TTL_MINUTES=10
CACHE_MAX_ENTRIES=500
RESOLVE_TIMEOUT_SECONDS=45
MAX_PLAYLIST_ITEMS=30
# Cap for the merged "best quality" option. 4K/8K sources are hundreds of MB
# and will exhaust a small instance's disk mid-request.
MAX_MERGE_HEIGHT=1080
MAX_CONCURRENT_RESOLVE=4

# ── Protection ────────────────────────────────────────────────────────────
RATE_WINDOW_SECONDS=60
RATE_MAX_RESOLVE=20
RATE_MAX_DOWNLOAD=40
# Let /api/dl relay allowlisted platform CDNs. Turn off to force engine-only.
ALLOW_DIRECT_PROXY=true
CORS_ORIGIN=*

# ── Third-party fallback providers (no API key needed) ────────────────────
# Comma-separated list to switch providers off: izuka,savefbs,azbry,threadsworker
PROVIDERS_DISABLED=
# Per-request timeout for a provider before the next method is tried
PROVIDER_TIMEOUT_SECONDS=15
# Override base URLs if a provider moves domain
IZUKA_BASE=https://my.izuka-api.xyz
SAVEFBS_BASE=https://savefbs.com
AZBRY_BASE=https://api.azbry.com
THREADS_WORKER_BASE=
# Engine circuit breaker: after N bot-check/login failures for one platform,
# yt-dlp is moved to the end of that platform's chain for M minutes.
ENGINE_BREAKER_THRESHOLD=2
ENGINE_BREAKER_MINUTES=15

# ── Optional upstreams ────────────────────────────────────────────────────
# Browser UA used for scraping. Change it if a platform starts blocking you.
APP_USER_AGENT=
# Your own Instagram resolver (must accept ?url=... or contain {url}).
# Leave empty to use the built-in public embed fallback.
IG_API_ENDPOINT=
# A SELF-HOSTED cobalt instance (api.cobalt.tools requires Turnstile/JWT and
# will not work as a dependency). Optional extra fallback.
COBALT_BASE=
COBALT_API_KEY=
